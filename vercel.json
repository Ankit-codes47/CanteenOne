{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "client": {
      "root": "client",
      "framework": "vite",
      "rewrites": [
        { "source": "/", "destination": "/index.html" },
        { "source": "/shop", "destination": "/index.html" },
        { "source": "/orders", "destination": "/index.html" },
        { "source": "/login", "destination": "/index.html" }
      ]
    },
    "server": {
      "root": "server",
      "framework": "express"
    }
  },
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": {
        "service": "server"
      }
    },
    {
      "source": "/(.*)",
      "destination": {
        "service": "client"
      }
    }
  ]
}
