# Add this variable in Vercel Project Settings > Environment Variables.
# Keep your actual connection string in your local .env file (never commit it).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Optional admin portal account (created on first successful MongoDB initialization).
# Use these to sign in at /admin.html; ADMIN_ID behaves like a vendor login ID.
ADMIN_NAME=CanteenOne Admin
ADMIN_ID=CTN-ADMIN-01
# Optional internal account email; users sign in with ADMIN_ID, not this email.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Cloudinary signed product image uploads (keep API secret server-side only).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret
