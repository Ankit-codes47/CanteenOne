# Add this variable in Vercel Project Settings > Environment Variables.
# Keep your actual connection string in your local .env file (never commit it).
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority

# Optional admin portal account (created on first successful MongoDB initialization).
# Use these to sign in at /admin.html; ADMIN_ID behaves like a vendor login ID.
ADMIN_NAME=CanteenOne Admin
ADMIN_ID=CTN-ADMIN-01
# Optional internal account email; users sign in with ADMIN_ID, not this email.
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# Cloudinary signed product image uploads (keep API secret server-side only).
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-cloudinary-api-key
CLOUDINARY_API_SECRET=your-cloudinary-api-secret

# Razorpay Standard Checkout (start with Test Mode credentials).
# Keep the key secret and webhook secret server-side; only the key ID is sent to Checkout.
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret

# Twilio Verify SMS OTP for student login and registration.
# Configure the Verify Service code length to 4 in Twilio Console.
TWILIO_ACCOUNT_SID=ACyour-account-sid
TWILIO_AUTH_TOKEN=your-twilio-auth-token
TWILIO_VERIFY_SERVICE_SID=VAyour-verify-service-sid
